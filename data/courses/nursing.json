    "faq": {
      "id": "nursing-faq",
      "component": "NursingFAQ",
      "enabled": true,
      "type": "faq",

      "eyebrow": {
        "text": "Need Answers?",
        "icon": "HelpCircle"
      },

      "title": {
        "prefix": "Frequently Asked",
        "highlight": "Questions"
      },

      "description": "Everything you need to know about studying nursing abroad, eligibility, licensing, career opportunities and support.",

      "items": [
        {
          "id": 1,
          "question": "Is nursing abroad a good career option?",
          "answer": "Nursing is a globally recognised healthcare profession with opportunities across hospitals, clinics, communities and specialised healthcare settings. The right destination depends on your academic profile, goals and career plans."
        },
        {
          "id": 2,
          "question": "Which countries are best for Indian nursing students?",
          "answer": "There is no single best country for every student. The right choice depends on your budget, eligibility, language requirements, licensing pathway, career goals and long-term plans."
        },
        {
          "id": 3,
          "question": "Can I settle abroad after studying nursing?",
          "answer": "Some countries have work and migration pathways for qualified healthcare professionals. Eligibility and immigration rules vary by country and can change over time."
        },
        {
          "id": 4,
          "question": "Which exams are required to work abroad as a nurse?",
          "answer": "Requirements depend on the country. Some destinations may require licensing exams such as NCLEX-RN, while others have their own registration and assessment processes."
        },
        {
          "id": 5,
          "question": "Do I need IELTS or OET?",
          "answer": "English-language requirements vary by country and registration authority. IELTS, OET or another accepted English test may be required depending on the pathway."
        },
        {
          "id": 6,
          "question": "How much can nurses earn abroad?",
          "answer": "Nursing salaries vary significantly based on country, role, experience, location and employer. We can provide an indicative range during counselling."
        },
        {
          "id": 7,
          "question": "How long does a nursing course take?",
          "answer": "Course duration varies depending on the country, university and programme. Your counsellor can help you understand the duration for your preferred destination."
        },
        {
          "id": 8,
          "question": "Can I take my family with me?",
          "answer": "Family migration options depend on the destination, visa type, employment status and current immigration rules. We can help you understand the relevant pathway."
        },
        {
          "id": 9,
          "question": "Will Medico Yatra help with licensing?",
          "answer": "Yes. We provide guidance around relevant licensing exams, registration requirements and the career pathway for your selected destination."
        },
        {
          "id": 10,
          "question": "How does Medico Yatra help students?",
          "answer": "We support students across counselling, university selection, admission, visa and travel preparation, licensing guidance and post-arrival support."
        }
      ],

